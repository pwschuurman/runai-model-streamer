load("//old_toolchain:rules.bzl", "runai_cc_configure_toolchain", "runai_cc_autoconf_impl_x86", "runai_cc_autoconf_impl_arm64")

runai_cc_configure_toolchain("x86_64", runai_cc_autoconf_impl_x86)
runai_cc_configure_toolchain("aarch64", runai_cc_autoconf_impl_arm64)

register_toolchains(
    "//toolchain:x86_64_linux_toolchain",
    "//toolchain:aarch64_linux_toolchain",
)

