    name = "google_cloud_cpp",
    sha256 = "10867580483cb338e7d50920c2383698f3572cc6b4c7d072e38d5f43755cbd80",
    strip_prefix = "google-cloud-cpp-2.37.0",
    url = "https://github.com/googleapis/google-cloud-cpp/archive/v2.37.0.tar.gz",
)

